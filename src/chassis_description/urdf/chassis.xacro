<?xml version="1.0"?>
<!--
  Chassis Description entrypoint.

  v1_0 is the current production chassis. v1_1 is prepared as a separate
  variant so the new chassis can be integrated without changing launch files.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="chassis_version" default="v1_0"/>

  <xacro:if value="$(eval chassis_version == 'v1_0' or chassis_version == 'v1.0' or chassis_version == '1.0' or chassis_version == 1.0)">
    <xacro:include filename="$(find chassis_description)/urdf/variants/V1.0/chassis_v1_0.xacro"/>
  </xacro:if>

  <xacro:if value="$(eval chassis_version == 'v1_1' or chassis_version == 'v1.1' or chassis_version == '1.1' or chassis_version == 1.1)">
    <xacro:include filename="$(find chassis_description)/urdf/variants/V1.1/chassis_v1_1.xacro"/>
  </xacro:if>

</robot>
