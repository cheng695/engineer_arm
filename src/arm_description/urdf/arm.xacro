<?xml version="1.0"?>
<!--
  Arm Description — 7-DOF 机械臂 URDF 入口文件

  子文件结构（对标 OpenArm 的模块化组织）：
    arm_links.xacro   — 全部 link 定义（惯量、视觉、碰撞）
    arm_joints.xacro  — 全部 joint 定义（限位、运动学）
    arm.ros2_control.xacro  — ros2_control 硬件接口与控制器参数

  用法：
    xacro arm.xacro
-->
<robot name="arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Links -->
  <xacro:include filename="$(find arm_description)/urdf/arm_links.xacro"/>

  <!-- Joints -->
  <xacro:include filename="$(find arm_description)/urdf/arm_joints.xacro"/>

</robot>
