      <param name="motor_model">J4310</param>
      <param name="can_bus">can1</param>
      <param name="kp">60.0</param>
      <param name="kd">1.0</param>
      <param name="lower_limit">-1.5708</param>
      <param name="upper_limit">1.5708</param>
    </joint>
    <!-- 夹爪关节：一直包含，无 can_id 则由硬件接口自动按 Mock 处理 -->
    <joint name="joint_right_finger">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <param name="lower_limit">0.0</param>
      <param name="upper_limit">0.04</param>
    </joint>
  </ros2_control>
  <!-- Connect chassis to arm -->
  <joint name="chassis_to_arm_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.15 0 0.05"/>
    <parent link="chassis_link"/>
    <child link="base_link"/>
  </joint>
  <joint name="gripper_base_joint" type="fixed">
    <parent link="Link7"/>
    <child link="gripper_base_link"/>
    <origin rpy="0 0 0" xyz="0.056450 0 0"/>
  </joint>
  <!-- Future: include chassis_description connection here -->
</robot>
