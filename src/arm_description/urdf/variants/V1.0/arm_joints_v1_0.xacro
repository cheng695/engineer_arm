<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Arm v1.0 joint definitions. Keep this file stable when adding future variants. -->

  <!-- ==================== J1: base_link → Link_1 ==================== -->
  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.02325" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="Link_1"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-2.3562" upper="2.3562" effort="20" velocity="2"/>
  </joint>

  <!-- ==================== J2: Link_1 → Link_2 ==================== -->
  <joint name="joint2" type="revolute">
    <origin xyz="-0.0022135 0 0.085" rpy="0 0 0"/>
    <parent link="Link_1"/>
    <child link="Link_2"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-0.262" upper="1.134" effort="20" velocity="2"/>
  </joint>

  <!-- ==================== J3: Link_2 → Link3 ==================== -->
  <joint name="joint3" type="revolute">
    <origin xyz="0.0022135 0.009675 0.35" rpy="0 0 0"/>
    <parent link="Link_2"/>
    <child link="Link3"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.9599" upper="0.9599" effort="20" velocity="2"/>
  </joint>

  <!-- ==================== J4: Link3 → Link4 ==================== -->
  <joint name="joint4" type="revolute">
    <origin xyz="0.22238 -0.009675 -0.005" rpy="0 0 0"/>
    <parent link="Link3"/>
    <child link="Link4"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.3562" upper="2.3562" effort="9" velocity="2"/>
  </joint>

  <!-- ==================== J5: Link4 → Link5 ==================== -->
  <joint name="joint5" type="revolute">
    <origin xyz="0.059625 0 0" rpy="0 0 0"/>
    <parent link="Link4"/>
    <child link="Link5"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="9" velocity="2"/>
  </joint>

  <!-- ==================== J6: Link5 → Link6 ==================== -->
  <joint name="joint6" type="revolute">
    <origin xyz="0.07 0.0015 0" rpy="0 0 0"/>
    <parent link="Link5"/>
    <child link="Link6"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="3" velocity="2"/>
  </joint>

  <!-- ==================== J7: Link6 → Link7 ==================== -->
  <joint name="joint7" type="revolute">
    <origin xyz="0.0973 -0.0015 0" rpy="0 0 0"/>
    <parent link="Link6"/>
    <child link="Link7"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="3" velocity="2"/>
  </joint>

  <!-- ==================== tool: Link7 → tool_link ==================== -->
  <joint name="joint_tool" type="fixed">
    <origin xyz="0.048 0 0" rpy="0 0 0"/>
    <parent link="Link7"/>
    <child link="tool_link"/>
  </joint>

</robot>
