<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="arm_ros2_control" params="name arm_version:=v1_0 use_mock_hardware:=false gravity_compensation_mode:=off gravity_effort_scale:=0.0 j2j3_j3_gravity_effort_scale:=1.0 active_real_joints:='' can0_interface:=can0 can1_interface:=can1 robot_description_file:=/tmp/robot_description.urdf">
    <xacro:property name="is_arm_v1_1" value="${arm_version == 'v1_1' or arm_version == 'v1.1' or arm_version == '1.1' or arm_version == 1.1}"/>
    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>arm_hardware_interface/MockArmHardwareInterface</plugin>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware}">
          <plugin>arm_hardware_interface/RealArmHardwareInterface</plugin>
        </xacro:unless>
        <param name="robot_description">${robot_description_file}</param>
        <param name="gravity_compensation_mode">${gravity_compensation_mode}</param>
        <param name="gravity_effort_scale">${gravity_effort_scale}</param>
        <param name="active_real_joints">${active_real_joints}</param>
        <param name="j2j3_coupling">0.986</param>
        <param name="j2j3_j3_scale">1.0</param>
        <param name="j2j3_j3_offset">0.0</param>
        <param name="j2j3_poly_a3">0.0</param>
        <param name="j2j3_poly_a2">0.0</param>
        <param name="j2j3_poly_a1">0.0</param>
        <param name="j2j3_poly_a0">0.0</param>
        <param name="j2j3_scale_mode">divide</param>
        <param name="j2j3_j3_gravity_effort_scale">${j2j3_j3_gravity_effort_scale}</param>
      </hardware>

      <!-- J1-J4 使用 CAN 总线 can0 -->
      <joint name="joint1">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="can_id">1</param>
        <param name="recv_can_id">0x11</param>
        <param name="motor_model">J8009</param>
        <param name="can_bus">${can0_interface}</param>
        <param name="kp">120.0</param>
        <param name="kd">3.0</param>
        <param name="lower_limit">-2.3562</param>
        <param name="upper_limit">2.3562</param>
        <param name="direction">-1.0</param>
      </joint>

      <joint name="joint2">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="can_id">2</param>
        <param name="motor_model">J8009</param>
        <param name="can_bus">${can0_interface}</param>
        <param name="kp">240.0</param>
        <param name="kd">3.0</param>
        <param name="lower_limit">${-0.262 if is_arm_v1_1 else -0.262}</param>
        <param name="upper_limit">${1.204 if is_arm_v1_1 else 1.134}</param>
      </joint>

      <joint name="joint3">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="can_id">3</param>
        <param name="motor_model">J8009</param>
        <param name="can_bus">${can0_interface}</param>
        <param name="kp">240.0</param>
        <param name="kd">3.0</param>
        <param name="lower_limit">-0.9599</param>
        <param name="upper_limit">${1.221 if is_arm_v1_1 else 0.9599}</param>
      </joint>

      <joint name="joint4">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="can_id">4</param>
        <param name="motor_model">J4340</param>
        <param name="can_bus">${can0_interface}</param>
        <param name="kp">120.0</param>
        <param name="kd">3.0</param>
        <param name="lower_limit">${-3.1416 if is_arm_v1_1 else -2.3562}</param>
        <param name="upper_limit">${3.1416 if is_arm_v1_1 else 2.3562}</param>
      </joint>

      <!-- J5-J7 使用 CAN 总线 can1 -->
      <joint name="joint5">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="can_id">5</param>
        <param name="motor_model">J4340</param>
        <param name="can_bus">${can1_interface}</param>
        <param name="kp">120.0</param>
        <param name="kd">3.0</param>
        <param name="lower_limit">${-0.78 if is_arm_v1_1 else -1.5708}</param>
        <param name="upper_limit">1.5708</param>
        <param name="direction">-1.0</param>
      </joint>

      <joint name="joint6">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="can_id">6</param>
        <param name="motor_model">J4310</param>
        <param name="can_bus">${can1_interface}</param>
        <param name="kp">120.0</param>
        <param name="kd">1.0</param>
        <param name="lower_limit">-1.5708</param>
        <param name="upper_limit">1.5708</param>
      </joint>

      <joint name="joint7">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="can_id">7</param>
        <param name="motor_model">J4310</param>
        <param name="can_bus">${can1_interface}</param>
        <param name="kp">60.0</param>
        <param name="kd">1.0</param>
        <param name="lower_limit">${-3.1416 if is_arm_v1_1 else -1.5708}</param>
        <param name="upper_limit">${3.1416 if is_arm_v1_1 else 1.5708}</param>
      </joint>

      <!-- 夹爪关节：4310 电机，挂在 can1，CAN ID/反馈 ID 均为 8 -->
      <joint name="joint_right_finger">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="can_id">8</param>
        <param name="recv_can_id">8</param>
        <param name="motor_model">J4310</param>
        <param name="can_bus">${can1_interface}</param>
        <param name="kp">60.0</param>
        <param name="kd">1.0</param>
        <param name="lower_limit">0.0</param>
        <param name="upper_limit">1.2</param>
      </joint>

    </ros2_control>
  </xacro:macro>

</robot>
