<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="arm_ros2_control" params="name arm_version:=v1_0 use_mock_hardware:=false use_mujoco_hardware:=false mujoco_model_path:='' gravity_compensation_mode:=off gravity_effort_scale:=0.0 j2j3_coupling:=0.0 j2j3_j3_scale:=1.0 j2j3_j3_offset:=0.0 j2j3_scale_mode:=divide j2j3_poly_a3:=0.0 j2j3_poly_a2:=0.0 j2j3_poly_a1:=0.0 j2j3_poly_a0:=0.0 joint1_kp:=120.0 joint1_kd:=3.0 joint2_kp:=240.0 joint2_kd:=3.0 joint3_kp:=240.0 joint3_kd:=3.0 joint4_kp:=120.0 joint4_kd:=3.0 joint5_kp:=120.0 joint5_kd:=3.0 joint6_kp:=120.0 joint6_kd:=1.0 joint7_kp:=60.0 joint7_kd:=1.0 joint_right_finger_kp:=60.0 joint_right_finger_kd:=1.0 active_real_joints:='' can0_interface:=can0 can1_interface:=can1 robot_description_file:=/tmp/robot_description.urdf">
    <xacro:property name="is_arm_v1_1" value="${arm_version == 'v1_1' or arm_version == 'v1.1' or arm_version == '1.1' or arm_version == 1.1}"/>
    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_mujoco_hardware}">
          <plugin>arm_hardware_interface/MujocoArmHardwareInterface</plugin>
        </xacro:if>
        <xacro:if value="${not use_mujoco_hardware and use_mock_hardware}">
          <plugin>arm_hardware_interface/MockArmHardwareInterface</plugin>
        </xacro:if>
        <xacro:if value="${not use_mujoco_hardware and not use_mock_hardware}">
          <plugin>arm_hardware_interface/RealArmHardwareInterface</plugin>
        </xacro:if>
        <param name="robot_description">${robot_description_file}</param>
        <param name="mujoco_model_path">${mujoco_model_path}</param>
        <param name="gravity_compensation_mode">${gravity_compensation_mode}</param>
        <param name="gravity_effort_scale">${gravity_effort_scale}</param>
        <param name="active_real_joints">${active_real_joints}</param>
        <param name="j2j3_coupling">${j2j3_coupling}</param>
        <param name="j2j3_j3_scale">${j2j3_j3_scale}</param>
        <param name="j2j3_j3_offset">${j2j3_j3_offset}</param>
        <param name="j2j3_scale_mode">${j2j3_scale_mode}</param>
        <param name="j2j3_poly_a3">${j2j3_poly_a3}</param>
        <param name="j2j3_poly_a2">${j2j3_poly_a2}</param>
        <param name="j2j3_poly_a1">${j2j3_poly_a1}</param>
        <param name="j2j3_poly_a0">${j2j3_poly_a0}</param>
      </hardware>

      <!-- J1-J4 使用 CAN 总线 can0 -->
      <joint name="joint1">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="can_id">1</param>
        <param name="recv_can_id">0x11</param>
        <param name="motor_model">J8009</param>
        <param name="can_bus">${can0_interface}</param>
        <param name="kp">${joint1_kp}</param>
        <param name="kd">${joint1_kd}</param>
        <param name="lower_limit">-2.3562</param>
        <param name="upper_limit">2.3562</param>
        <param name="direction">-1.0</param>
      </joint>

      <joint name="joint2">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="can_id">2</param>
        <param name="motor_model">J8009</param>
        <param name="can_bus">${can0_interface}</param>
        <param name="kp">${joint2_kp}</param>
        <param name="kd">${joint2_kd}</param>
        <param name="lower_limit">${-0.262 if is_arm_v1_1 else -0.262}</param>
        <param name="upper_limit">${1.204 if is_arm_v1_1 else 1.134}</param>
      </joint>

      <joint name="joint3">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="can_id">3</param>
        <param name="motor_model">J8009</param>
        <param name="can_bus">${can0_interface}</param>
        <param name="kp">${joint3_kp}</param>
        <param name="kd">${joint3_kd}</param>
        <param name="lower_limit">-0.9599</param>
        <param name="upper_limit">${1.221 if is_arm_v1_1 else 0.9599}</param>
      </joint>

      <joint name="joint4">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="can_id">4</param>
        <param name="motor_model">J4340</param>
        <param name="can_bus">${can0_interface}</param>
        <param name="kp">${joint4_kp}</param>
        <param name="kd">${joint4_kd}</param>
        <param name="lower_limit">${-3.1416 if is_arm_v1_1 else -2.3562}</param>
        <param name="upper_limit">${3.1416 if is_arm_v1_1 else 2.3562}</param>
      </joint>

      <!-- J5-J7 使用 CAN 总线 can1 -->
      <joint name="joint5">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="can_id">5</param>
        <param name="motor_model">J4340</param>
        <param name="can_bus">${can1_interface}</param>
        <param name="kp">${joint5_kp}</param>
        <param name="kd">${joint5_kd}</param>
        <param name="lower_limit">${-1.5708}</param>
        <param name="upper_limit">1.5708</param>
        <param name="direction">-1.0</param>
      </joint>

      <joint name="joint6">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="can_id">6</param>
        <param name="motor_model">J4310</param>
        <param name="can_bus">${can1_interface}</param>
        <param name="kp">${joint6_kp}</param>
        <param name="kd">${joint6_kd}</param>
        <param name="lower_limit">-1.5708</param>
        <param name="upper_limit">1.5708</param>
      </joint>

      <joint name="joint7">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="can_id">7</param>
        <param name="motor_model">J4310</param>
        <param name="can_bus">${can1_interface}</param>
        <param name="kp">${joint7_kp}</param>
        <param name="kd">${joint7_kd}</param>
        <param name="lower_limit">${-3.1416 if is_arm_v1_1 else -1.5708}</param>
        <param name="upper_limit">${3.1416 if is_arm_v1_1 else 1.5708}</param>
      </joint>

      <!-- 夹爪关节：4310 电机，挂在 can1，CAN ID/反馈 ID 均为 8 -->
      <joint name="joint_right_finger">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <param name="can_id">8</param>
        <param name="recv_can_id">8</param>
        <param name="motor_model">J4310</param>
        <param name="can_bus">${can1_interface}</param>
        <param name="kp">${joint_right_finger_kp}</param>
        <param name="kd">${joint_right_finger_kd}</param>
        <param name="lower_limit">-1.45</param>
        <param name="upper_limit">0.0</param>
      </joint>

    </ros2_control>
  </xacro:macro>

</robot>
